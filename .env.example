# Supabase credentials for populate_pl_matches.py --insert
# On the VPS: cp /var/www/innovera-backend/.env .env   (reuses the WC2026 creds)
# Or fill these in and rename to .env  (.env is gitignored — never commit real keys)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# SUPABASE_KEY=your-anon-key   # fallback if no service key
